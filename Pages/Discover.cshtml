@page
@model BookBoard.Pages.DiscoverModel
@{
    ViewData["Title"] = "Discover";
    ViewData["CurrentUserId"] = Model.CurrentUserId;
    ViewData["SavedBoardIds"] = Model.SavedBoardIds;
}

<div class="discover-page">
    <div class="section-heading text-center">
        <h1>Discover Public Boards</h1>
        <p>Explore reader-made boards by mood, aesthetic, and emotional reading vibe.</p>
    </div>

    <form method="get" class="discover-search">
        <input
            type="text"
            name="query"
            value="@Model.SearchQuery"
            placeholder="Try: rainy day, religious awakening, dark academia, healing..." />

        <button type="submit">Search</button>
    </form>

    @if (Model.PopularMoods.Count > 0)
    {
        <div class="mood-chip-row">
            <span class="mood-chip-label">Trending moods</span>

            @foreach (var mood in Model.PopularMoods)
            {
                <a asp-page="/Discover"
                   asp-route-mood="@mood.Mood"
                   class="mood-chip @(Model.SelectedMood == mood.Mood ? "active" : "")">
                    @mood.Mood
                    <span class="mood-chip-count">@mood.Count</span>
                </a>
            }
        </div>
    }

    @if (Model.SimilarToBoardId.HasValue)
    {
        <div class="discover-feed-section">
            <h3 class="feed-label">Similar to "@Model.SimilarBoardTitle"</h3>

            @if (Model.SimilarBoards.Count == 0)
            {
                <p class="empty-small">
                    No similar public boards found yet. Add more tags to your boards to improve matching.
                </p>
            }
            else
            {
                <div class="boards-grid">
                    @foreach (var match in Model.SimilarBoards)
                    {
                        <div class="similar-board-result-card">
                            <partial name="_BoardAestheticCard" model="match.Board" />

                            <div class="similar-match-note">
                                <span>@match.Score shared vibe(s)</span>

                                @if (match.MatchedTags.Count > 0)
                                {
                                    <div class="small-tag-row">
                                        @foreach (var tag in match.MatchedTags)
                                        {
                                            <span class="small-tag">@tag</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (Model.HasSearched)
    {
        <div class="discover-feed-section">
            <h3 class="feed-label">You searched: "@Model.SearchQuery"</h3>

            @if (Model.SimilarMoods.Count > 0)
            {
                <div class="related-moods-row">
                    <span class="mood-chip-label">Matching moods</span>

                    @foreach (var mood in Model.SimilarMoods)
                    {
                        <a asp-page="/Discover" asp-route-mood="@mood" class="mood-chip">@mood</a>
                    }
                </div>
            }

            <h4 class="feed-subtle-label">Boards matching this vibe</h4>

            @if (Model.MatchingBoards.Count == 0)
            {
                <p class="empty-small">No matching public boards found.</p>
            }
            else
            {
                <div class="boards-grid">
                    @foreach (var board in Model.MatchingBoards)
                    {
                        <partial name="_BoardAestheticCard" model="board" />
                    }
                </div>
            }

            @if (Model.MatchingBooks.Count > 0)
            {
                <h4 class="feed-subtle-label">Books matching this vibe</h4>

                <div class="book-grid">
                    @foreach (var book in Model.MatchingBooks)
                    {
                        <div class="book-card">
                            @if (!string.IsNullOrWhiteSpace(book.CoverUrl))
                            {
                                <img src="@book.CoverUrl" alt="@book.Title cover" class="real-book-cover" />
                            }
                            else
                            {
                                <div class="book-cover cover-two"></div>
                            }

                            <div class="book-info">
                                <h4>@book.Title</h4>

                                @if (!string.IsNullOrWhiteSpace(book.Author))
                                {
                                    <p>@book.Author</p>
                                }

                                @if (book.PublishedYear.HasValue)
                                {
                                    <p class="published-year">Published: @book.PublishedYear</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(book.ShortDescription))
                                {
                                    <p class="book-description">@book.ShortDescription</p>
                                }

                                @if (book.Board != null)
                                {
                                    <p class="book-location">
                                        From
                                        <a asp-page="/BoardDetails" asp-route-id="@book.Board.Id">
                                            @book.Board.Title
                                        </a>
                                    </p>
                                }

                                @if (!string.IsNullOrWhiteSpace(book.MoodTags))
                                {
                                    <div class="small-tag-row">
                                        @foreach (var tag in book.MoodTags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="small-tag">@tag</span>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(book.Reflection))
                                {
                                    <div class="book-reflection">
                                        "@book.Reflection"
                                    </div>
                                }

                                <div class="card-actions">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <a asp-page="/SaveBook" asp-route-bookId="@book.Id" class="btn btn-primary btn-sm">
                                            Save to Board
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-area="Identity"
                                           asp-page="/Account/Login"
                                           asp-route-returnUrl="@($"/SaveBook/{book.Id}")"
                                           class="btn btn-primary btn-sm">
                                            Login to Save
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (Model.SuggestedTags.Count > 0)
            {
                <div class="related-moods-row suggested-tags-row">
                    <span class="mood-chip-label">Keep exploring</span>

                    @foreach (var tag in Model.SuggestedTags)
                    {
                        <a asp-page="/Discover" asp-route-mood="@tag" class="mood-chip">@tag</a>
                    }
                </div>
            }
        </div>
    }
    else if (Model.HasSelectedMood)
    {
        <div class="discover-feed-section">
            <h3 class="feed-label">Boards for "@Model.SelectedMood"</h3>

            @if (Model.MoodBoards.Count == 0)
            {
                <p class="empty-small">No public boards found for this mood yet.</p>
            }
            else
            {
                <div class="boards-grid">
                    @foreach (var board in Model.MoodBoards)
                    {
                        <partial name="_BoardAestheticCard" model="board" />
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="discover-feed-section">
            <h3 class="feed-label">Recommended boards</h3>

            @if (Model.RecommendedBoards.Count == 0)
            {
                <p class="empty-small">No public boards yet.</p>
            }
            else
            {
                <div class="boards-grid">
                    @foreach (var board in Model.RecommendedBoards)
                    {
                        <partial name="_BoardAestheticCard" model="board" />
                    }
                </div>
            }

            @if (Model.RecommendedBooks.Count > 0)
            {
                <h4 class="feed-subtle-label">Matching books</h4>

                <div class="book-grid">
                    @foreach (var book in Model.RecommendedBooks)
                    {
                        <div class="book-card">
                            @if (!string.IsNullOrWhiteSpace(book.CoverUrl))
                            {
                                <img src="@book.CoverUrl" alt="@book.Title cover" class="real-book-cover" />
                            }
                            else
                            {
                                <div class="book-cover cover-two"></div>
                            }

                            <div class="book-info">
                                <h4>@book.Title</h4>

                                @if (!string.IsNullOrWhiteSpace(book.Author))
                                {
                                    <p>@book.Author</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(book.MoodTags))
                                {
                                    <div class="small-tag-row">
                                        @foreach (var tag in book.MoodTags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="small-tag">@tag</span>
                                        }
                                    </div>
                                }

                                @if (book.Board != null)
                                {
                                    <p class="book-location">
                                        From
                                        <a asp-page="/BoardDetails" asp-route-id="@book.Board.Id">
                                            @book.Board.Title
                                        </a>
                                    </p>
                                }

                                <div class="card-actions">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <a asp-page="/SaveBook" asp-route-bookId="@book.Id" class="btn btn-primary btn-sm">
                                            Save to Board
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-area="Identity"
                                           asp-page="/Account/Login"
                                           asp-route-returnUrl="@($"/SaveBook/{book.Id}")"
                                           class="btn btn-primary btn-sm">
                                            Login to Save
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>