@model BookBoard.Models.Board

@{
    string theme = string.IsNullOrWhiteSpace(Model.Theme) ? "cozy" : Model.Theme;
    string background = string.IsNullOrWhiteSpace(Model.BackgroundStyle) ? "soft-glow" : Model.BackgroundStyle;
    string accent = string.IsNullOrWhiteSpace(Model.AccentColor) ? "brown" : Model.AccentColor;

    string themeClass = "theme-" + theme.ToLower().Replace(" ", "-");
    string backgroundClass = "bg-" + background.ToLower().Replace(" ", "-");
    string accentClass = "accent-" + accent.ToLower().Replace(" ", "-");

    var collage = BookBoard.Services.CanvaCollageModel.FromBoard(Model);

    var savedBoardIds = ViewData["SavedBoardIds"] as HashSet<int> ?? new HashSet<int>();
    string currentUserId = ViewData["CurrentUserId"] as string ?? string.Empty;

    bool isOwner = !string.IsNullOrWhiteSpace(currentUserId) && Model.UserId == currentUserId;
    bool isSaved = savedBoardIds.Contains(Model.Id);

    string returnUrl = Context.Request.Path.ToString() + Context.Request.QueryString.ToString();
}

<div class="board-card-shell">
    <a asp-page="/BoardDetails"
       asp-route-id="@Model.Id"
       class="board-link-card aesthetic-board-card is-collage-card @themeClass @backgroundClass @accentClass">

        <partial name="_CanvaCollage" model="collage" />

        <div class="aesthetic-card-footer collage-footer">
            @if (Model.IsPublic)
            {
                <span class="visibility-badge">Public</span>
            }
            else
            {
                <span class="visibility-badge private">Private</span>
            }
            <span>@(Model.Books?.Count ?? 0) book(s)</span>
        </div>
    </a>

    @if (!isOwner)
    {
        <div class="board-save-card-action @(isSaved ? "always-visible" : "")">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form method="post" asp-page="/SaveBoard" asp-route-boardId="@Model.Id">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <button type="submit" class="save-board-mini @(isSaved ? "saved" : "")">
                        @(isSaved ? "In Your Inspiration" : "Save to Inspiration")
                    </button>
                </form>
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   asp-route-returnUrl="@returnUrl"
                   class="save-board-mini">
                    Login to Save
                </a>
            }
        </div>
    }
</div>
