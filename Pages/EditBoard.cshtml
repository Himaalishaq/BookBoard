@page "{id:int}"
@model BookBoard.Pages.EditBoardModel
@{
    ViewData["Title"] = "Edit Board";
}

<div class="create-board-page">
    <div class="section-heading text-center">
        <h1>Edit Board</h1>
        <p>Update the mood, aesthetic, and visual identity of this board.</p>
    </div>

    <form method="post" class="board-form">
        <div asp-validation-summary="All" class="text-danger"></div>

        <input type="hidden" asp-for="Board.Id" />

        <div class="form-group">
            <label asp-for="Board.Title">Board Title</label>
            <input asp-for="Board.Title" />
            <span asp-validation-for="Board.Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Board.Description">Description</label>
            <textarea asp-for="Board.Description"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Board.MoodTags">Mood / Vibe Tags</label>
            <input asp-for="Board.MoodTags" />
            <small>Separate tags with commas.</small>
        </div>

        <div class="aesthetic-studio">
            <h2>Board Aesthetic Studio</h2>
            <p>Change how this board appears when people browse through reading worlds.</p>

            <div class="form-group">
                <label asp-for="Board.Theme">Theme</label>
                <input asp-for="Board.Theme" list="theme-options" placeholder="Type your own, or pick a suggestion" />
                <datalist id="theme-options">
                    <option value="cozy" />
                    <option value="spiritual" />
                    <option value="summer" />
                    <option value="dark-academia" />
                    <option value="rainy" />
                    <option value="fantasy" />
                    <option value="autumn" />
                    <option value="winter" />
                    <option value="coastal" />
                    <option value="gothic" />
                    <option value="whimsical" />
                    <option value="minimalist" />
                </datalist>
                <small>Pick a suggestion or type any theme name that fits your board.</small>
            </div>

            <div class="form-group">
                <label asp-for="Board.BackgroundStyle">Background Style</label>
                <input asp-for="Board.BackgroundStyle" list="background-options" placeholder="Type your own, or pick a suggestion" />
                <datalist id="background-options">
                    <option value="soft-glow" />
                    <option value="stars" />
                    <option value="sunlight" />
                    <option value="paper" />
                    <option value="rain" />
                    <option value="forest" />
                    <option value="fog" />
                    <option value="candlelight" />
                    <option value="moonlight" />
                    <option value="watercolor" />
                </datalist>
                <small>Pick a suggestion or type any background style.</small>
            </div>

            <div class="form-group">
                <label asp-for="Board.AccentColor">Accent Color</label>
                <div class="accent-swatch-picker">
                    <input type="radio" asp-for="Board.AccentColor" value="brown" id="accent-brown" class="accent-swatch-radio" />
                    <label for="accent-brown" class="accent-swatch" style="background: linear-gradient(135deg, #e6d2bf, #b98f6e);" title="Warm Brown"></label>

                    <input type="radio" asp-for="Board.AccentColor" value="gold" id="accent-gold" class="accent-swatch-radio" />
                    <label for="accent-gold" class="accent-swatch" style="background: linear-gradient(135deg, #f1dba6, #d9b46f);" title="Soft Gold"></label>

                    <input type="radio" asp-for="Board.AccentColor" value="green" id="accent-green" class="accent-swatch-radio" />
                    <label for="accent-green" class="accent-swatch" style="background: linear-gradient(135deg, #cfe3c1, #8aaa7b);" title="Forest Green"></label>

                    <input type="radio" asp-for="Board.AccentColor" value="blue" id="accent-blue" class="accent-swatch-radio" />
                    <label for="accent-blue" class="accent-swatch" style="background: linear-gradient(135deg, #cdd7ef, #899bc8);" title="Midnight Blue"></label>

                    <input type="radio" asp-for="Board.AccentColor" value="lavender" id="accent-lavender" class="accent-swatch-radio" />
                    <label for="accent-lavender" class="accent-swatch" style="background: linear-gradient(135deg, #e8dbf3, #bda6d9);" title="Lavender"></label>

                    <input type="radio" asp-for="Board.AccentColor" value="rose" id="accent-rose" class="accent-swatch-radio" />
                    <label for="accent-rose" class="accent-swatch" style="background: linear-gradient(135deg, #f2dcdc, #d8a1a1);" title="Dusty Rose"></label>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Board.IconSymbols">Board Symbols</label>
                <input asp-for="Board.IconSymbols" placeholder="🌙, ✨, 🕯️" />
                <small>Separate symbols with commas.</small>
            </div>
        </div>

        <div class="checkbox-row">
            <input asp-for="Board.IsPublic" />
            <label asp-for="Board.IsPublic">Make this board public</label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-page="/BoardDetails" asp-route-id="@Model.Board.Id" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}