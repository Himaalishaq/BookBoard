@page
@model BookBoard.Pages.BoardsModel
@{
    ViewData["Title"] = "Boards";
    ViewData["CurrentUserId"] = Model.CurrentUserId;
    ViewData["SavedBoardIds"] = Model.SavedBoardIds;
}

<div class="boards-page">
    <div class="section-heading text-center">
        <h1>Your Boards</h1>
        <p>Create and organize beautiful reading spaces for every mood and moment.</p>
    </div>

    <div class="text-center">
        <a asp-page="/CreateBoard" class="btn btn-primary">Create New Board</a>
    </div>

    <div class="boards-grid">
        @if (Model.Boards.Count == 0)
        {
            <div class="board-card add-board-card">
                <div class="add-board-inner">
                    <div class="plus-icon">+</div>
                    <h3>No boards yet</h3>
                    <p>Create your first aesthetic reading board.</p>
                    <a asp-page="/CreateBoard" class="btn btn-outline-secondary mt-3">Start a Board</a>
                </div>
            </div>
        }
        else
        {
            @foreach (var board in Model.Boards)
            {
                <partial name="_BoardAestheticCard" model="board" />
            }
        }
    </div>
</div>