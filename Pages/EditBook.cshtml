@page "{id:int}"
@model BookBoard.Pages.EditBookModel
@{
    ViewData["Title"] = "Edit Book";
}

<div class="create-board-page">
    <div class="section-heading text-center">
        <h1>Edit Book</h1>
        <p>Update this book’s mood tags, reflection, or details.</p>
    </div>

    <form method="post" class="board-form">
        <div asp-validation-summary="All" class="text-danger"></div>

        <input type="hidden" asp-for="BoardBook.Id" />
        <input type="hidden" asp-for="BoardBook.BoardId" />

        <div class="form-group">
            <label asp-for="BoardBook.Title">Book Title</label>
            <input asp-for="BoardBook.Title" />
            <span asp-validation-for="BoardBook.Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="BoardBook.Author">Author</label>
            <input asp-for="BoardBook.Author" />
        </div>

        <div class="form-group">
            <label asp-for="BoardBook.CoverUrl">Cover Image URL</label>
            <input asp-for="BoardBook.CoverUrl" />
            <small>You can leave this blank.</small>
        </div>

        <div class="form-group">
            <label asp-for="BoardBook.MoodTags">Mood / Vibe Tags</label>
            <input asp-for="BoardBook.MoodTags" />
            <small>Separate tags with commas.</small>
        </div>

        <div class="form-group">
            <label asp-for="BoardBook.Reflection">Your Reflection</label>
            <textarea asp-for="BoardBook.Reflection"></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-page="/BoardDetails" asp-route-id="@Model.BoardBook.BoardId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}