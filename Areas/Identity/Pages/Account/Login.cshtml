@page
@model BookBoard.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-page">
    <section class="auth-card">
        <div class="auth-intro">
            <span class="home-kicker">Welcome back</span>
            <h1>Sign in to your reading boards.</h1>
            <p>
                Your boards, saved inspiration, and mood feed stay with this account —
                even after you close the tab.
            </p>
        </div>

        <form id="account" method="post" class="auth-form" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" autocomplete="username" placeholder="you@email.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" autocomplete="current-password" placeholder="Your password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="checkbox-row">
                <input asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe">Keep me signed in</label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Log in</button>
            </div>

            <p class="auth-switch">
                New here?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
            </p>
        </form>
    </section>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
